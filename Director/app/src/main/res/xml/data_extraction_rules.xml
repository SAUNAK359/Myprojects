    <device-transfer>
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="director/" />
        <exclude domain="sharedpref" path="director_secure_settings.xml" />
        <exclude domain="sharedpref" path="sierra_account_session_v1.xml" />
        <exclude domain="sharedpref" path="sierra_ai_settlement_v1.xml" />
        <exclude domain="sharedpref" path="sierra_vision_preferences.xml" />
        <exclude domain="sharedpref" path="sierra_install_identity_v1.xml" />
        <exclude domain="sharedpref" path="sierra_gemini_key_v1.xml" />
    </device-transfer>
</data-extraction-rules>
