<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="director/" />
        <exclude domain="sharedpref" path="director_secure_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="director/" />
        <exclude domain="sharedpref" path="director_secure_settings.xml" />
    </device-transfer>
</data-extraction-rules>
